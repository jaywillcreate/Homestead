# Copy to .env.local and fill in what you want to enable.

# REQUIRED — Postgres connection string.
# Local dev: postgres://localhost:5432/homestead (brew install postgresql@17)
# Vercel: created automatically when you add a Neon database under Storage;
#         copy the same value here to seed or develop against it.
DATABASE_URL=

# File storage for invoice scans & job photos.
# Set on Vercel automatically when you add a Blob store under Storage.
# Leave empty locally to store files in storage/uploads/ instead.
BLOB_READ_WRITE_TOKEN=

# Enables AI invoice parsing (vendor, totals, line items extracted from PDF/JPG scans).
# Without it, uploads still work — you just fill the fields in manually.
# Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Enables real SMS delivery for phone verification and member notifications.
# Without these, the flow still works: codes are shown in the UI and sends are
# recorded as "simulated".
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Enables live "Find local pros" search results with real ratings and reviews.
# Without it, the screen shows clearly-labeled sample data.
# Get a key at https://console.cloud.google.com (Places API New)
GOOGLE_PLACES_API_KEY=
